{
  "manifest_version": 3,
  "name": "Netflix: Remove Games",
  "version": "1.0.0",
  "description": "Hides Netflix games: the Games tab, game rows, game cards and game heroes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "css": ["hide-games.css"],
      "run_at": "document_start"
    }
  ]
}
